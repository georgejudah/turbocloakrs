from typing import List, Optional, Tuple

class Vault:
    def __init__(self) -> None: ...
    def restore(self, text: str) -> str: ...
    def get_original(self, token: str) -> Optional[str]: ...
    def get_token(self, original: str) -> Optional[str]: ...
    def clear(self) -> None: ...
    def __len__(self) -> int: ...

class SafetyReport:
    is_safe: bool
    clean_text: str
    pii_detected: List[str]
    secrets_detected: List[str]
    contains_injection: bool
    injection_score: float
    def to_json(self) -> str: ...

def sanitize_text(text: str) -> str: ...
def clean_pii(text: str) -> Tuple[str, Vault]: ...
def find_pii(text: str) -> List[str]: ...
def contains_secrets(text: str) -> bool: ...
def redact_secrets(text: str) -> str: ...
def find_secrets(text: str) -> List[str]: ...
def is_jailbreak(text: str) -> bool: ...
def injection_score(text: str) -> float: ...
def inspect_all(text: str) -> SafetyReport: ...

__version__: str
